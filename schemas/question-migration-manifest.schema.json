{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alien0077/tw-junior-cap-learning/schemas/question-migration-manifest.schema.json",
  "title": "題目遷移清單",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "status", "items"],
  "properties": {
    "id": {"type": "string", "pattern": "^(chinese|english|math|science|social)-question-migration-pilot$"},
    "subject": {"enum": ["chinese", "english", "math", "science", "social"]},
    "status": {"enum": ["draft", "in-progress", "completed"]},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["questionId", "sourceLessonId", "targetUnitId", "migrationStatus"],
        "properties": {
          "questionId": {"type": "string", "pattern": "^question-(chinese|english|math|science|social)-"},
          "sourceLessonId": {"type": "string", "pattern": "^lesson-(chinese|english|math|science|social)-"},
          "targetUnitId": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^canonical-unit-(chinese|english|math|science|social)-"}]},
          "migrationStatus": {"enum": ["candidate", "pending-review", "not-applicable"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
