{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alien0077/tw-junior-cap-learning/schemas/question-migration-manifest.schema.json",
  "title": "題目遷移清單",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "status", "items"],
  "properties": {
    "id": {"const": "math-question-migration-pilot"},
    "subject": {"const": "math"},
    "status": {"enum": ["draft", "in-progress", "completed"]},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["questionId", "sourceLessonId", "targetUnitId", "migrationStatus"],
        "properties": {
          "questionId": {"type": "string", "pattern": "^question-math-"},
          "sourceLessonId": {"type": "string", "pattern": "^lesson-math-"},
          "targetUnitId": {"type": ["string", "null"], "pattern": "^canonical-unit-math-"},
          "migrationStatus": {"enum": ["candidate", "pending-review", "not-applicable"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
