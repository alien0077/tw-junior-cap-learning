{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alien0077/tw-junior-cap-learning/schemas/lesson.schema.json",
  "title": "自編教材",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "title",
    "knowledgeIds",
    "content",
    "provenance",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lesson-(chinese|english|math|science|social)-[a-z0-9-]+$"
    },
    "subject": {
      "enum": [
        "chinese",
        "english",
        "math",
        "science",
        "social"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "knowledgeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^kg-"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gradeRange": {
      "type": "array",
      "items": {
        "enum": [
          "7",
          "8",
          "9"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "sections"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "body"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "license"
      ],
      "properties": {
        "origin": {
          "const": "original"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "authoringNote": {
          "type": "string"
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "content-reviewed",
        "published",
        "deprecated"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^lesson-"
    },
    "studyHighlights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    },
    "studyReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "interactive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "goal",
        "steps"
      ],
      "properties": {
        "type": {
          "const": "guided-choice"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "options",
              "answer",
              "feedback"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^step-[0-9]+$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "feedback": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "enum": [
              "math",
              "science"
            ]
          }
        }
      },
      "then": {
        "required": [
          "interactive"
        ]
      }
    }
  ]
}
