{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alien0077/tw-junior-cap-learning/schemas/lesson.schema.json",
  "title": "自編教材",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "title",
    "knowledgeIds",
    "content",
    "provenance",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lesson-(chinese|english|math|science|social)-[a-z0-9-]+$"
    },
    "subject": {
      "enum": [
        "chinese",
        "english",
        "math",
        "science",
        "social"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "knowledgeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^kg-"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gradeRange": {
      "type": "array",
      "items": {
        "enum": [
          "7",
          "8",
          "9"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "sections"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "body"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "license"
      ],
      "properties": {
        "origin": {
          "const": "original"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "authoringNote": {
          "type": "string"
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "content-reviewed",
        "published",
        "deprecated"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^lesson-"
    },
    "studyHighlights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    },
    "studyReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authoringStandard": {
      "enum": [
        "legacy-outline",
        "full-lesson-v1",
        "version-fused-v1"
      ]
    },
    "versionResearch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisher",
          "edition",
          "sourceType",
          "sourceLocator",
          "reviewedAt",
          "findings",
          "licenseBoundary"
        ],
        "properties": {
          "publisher": {
            "enum": ["nani", "kanghsuan", "hanlin", "jiayin-hanlin"]
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "enum": ["local-download", "public-web", "licensed-file", "public-domain"]
          },
          "sourceLocator": {
            "type": "string",
            "minLength": 10
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "findings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concepts",
              "representations",
              "examplesOrEvidence",
              "misconceptions",
              "assessmentEmphasis"
            ],
            "properties": {
              "concepts": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 15}},
              "representations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
              "examplesOrEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
              "misconceptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
              "assessmentEmphasis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}}
            }
          },
          "licenseBoundary": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "fusionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commonCore", "versionDifferences", "originalAdditions", "llmSynthesisNote"],
      "properties": {
        "commonCore": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 15}},
        "versionDifferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
        "originalAdditions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 15}},
        "llmSynthesisNote": {"type": "string", "minLength": 80}
      }
    },
    "terraReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reviewedAt", "checks", "outcome"],
      "properties": {
        "model": {"const": "Terra"},
        "reviewedAt": {"type": "string", "format": "date"},
        "checks": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
        "outcome": {"enum": ["pass", "revise", "blocked"]}
      }
    },
    "lessonScope": {
      "enum": [
        "learning-content",
        "learning-performance",
        "topic",
        "theme",
        "domain"
      ]
    },
    "publisherResearch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisher",
          "edition",
          "subject",
          "chapterLocator",
          "sourceUrl",
          "access",
          "reviewedAt",
          "researchScope",
          "outcome",
          "copyrightBoundary"
        ],
        "properties": {
          "publisher": {
            "enum": [
              "nani",
              "kanghsuan",
              "hanlin",
              "jiayin-hanlin"
            ]
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "enum": [
              "chinese",
              "english",
              "math",
              "science",
              "social"
            ]
          },
          "chapterLocator": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "access": {
            "const": "public-open"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "researchScope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "teaching-sequence",
                "concept-progression",
                "activity-pattern",
                "assessment-pattern"
              ]
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 20
          },
          "copyrightBoundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "summary",
        "exitCheck"
      ],
      "properties": {
        "body": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "phase",
              "heading",
              "body"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "phase": {
                "enum": [
                  "hook",
                  "explain",
                  "worked-example",
                  "guided-practice",
                  "transfer",
                  "reflect"
                ]
              },
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 80
              }
            }
          }
        },
        "summary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "exitCheck": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "expectedEvidence"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 10
              },
              "expectedEvidence": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "interactive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "goal",
        "steps"
      ],
      "properties": {
        "type": {
          "enum": [
            "guided-choice",
            "algebra-expression-builder",
            "scientific-investigation"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "options",
              "answer",
              "feedback"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^step-[0-9]+$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "feedback": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scenario": {
          "type": "string",
          "minLength": 20
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "meaning"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^[a-z]$"
              },
              "meaning": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        }
      }
    }
    ,
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "engine",
        "mode",
        "goal",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sim-(math|science)-[a-z0-9-]+$"
        },
        "engine": {
          "enum": [
            "math-number-line",
            "math-algebra-balance",
            "math-function-graph",
            "math-geometry",
            "math-data-lab",
            "math-probability-lab",
            "science-motion-lab",
            "science-energy-lab",
            "science-particle-lab",
            "science-life-system",
            "science-earth-space",
            "concept-explorer"
          ]
        },
        "mode": {
          "enum": [
            "model",
            "explorer"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 12
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "mission": {
          "type": "string",
          "minLength": 12
        },
        "model": {
          "type": "string",
          "enum": [
            "general",
            "circulation"
          ]
        },
        "learningDesign": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "objective", "predictionPrompt", "steps", "evidencePrompt"],
          "properties": {
            "type": {
              "enum": ["equation-transform", "representation-match", "parameter-investigation", "data-investigation", "geometric-construction", "probability-experiment", "model-boundary"]
            },
            "objective": {"type": "string", "minLength": 20},
            "predictionPrompt": {"type": "string", "minLength": 20},
            "evidencePrompt": {"type": "string", "minLength": 20},
            "steps": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "action", "equation", "reason", "feedback"],
                "properties": {
                  "id": {"type": "string", "pattern": "^step-[0-9]+$"},
                  "action": {"type": "string", "minLength": 10},
                  "equation": {"type": "string", "minLength": 5},
                  "reason": {"type": "string", "minLength": 20},
                  "feedback": {"type": "string", "minLength": 20}
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "enum": [
              "math",
              "science"
            ]
          }
        }
      },
      "then": {
        "required": [
          "interactive",
          "simulation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authoringStandard": {
            "enum": ["full-lesson-v1", "version-fused-v1"]
          }
        },
        "required": [
          "authoringStandard"
        ]
      },
      "then": {
        "required": [
          "publisherResearch",
          "teaching"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authoringStandard": {"const": "version-fused-v1"}
        },
        "required": ["authoringStandard"]
      },
      "then": {
        "required": ["versionResearch", "fusionRecord"]
      }
    },
    {
      "if": {
        "properties": {
          "interactive": {
            "properties": {
              "type": {
                "const": "algebra-expression-builder"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "interactive"
        ]
      },
      "then": {
        "properties": {
          "interactive": {
            "required": [
              "scenario",
              "variables"
            ]
          }
        }
      }
    }
  ]
}
