{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alien0077/tw-junior-cap-learning/schemas/canonical-unit.schema.json",
  "title": "可教學 canonical unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "title", "teachable", "gradeRange", "curriculumIds", "status", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^canonical-unit-(chinese|english|math|science|social)-[a-z0-9-]+$"},
    "subject": {"enum": ["chinese", "english", "math", "science", "social"]},
    "title": {"type": "string", "minLength": 1},
    "teachable": {"type": "boolean"},
    "gradeRange": {"type": "array", "items": {"enum": ["7", "8", "9"]}, "minItems": 1, "uniqueItems": true},
    "semester": {"enum": ["上", "下"]},
    "curriculumIds": {"type": "array", "items": {"type": "string", "pattern": "^cur-"}, "minItems": 1, "uniqueItems": true},
    "status": {"enum": ["draft", "mapped", "verified", "deprecated"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "url", "locator", "verifiedAt", "confidence"],
      "properties": {
        "type": {"enum": ["official-curriculum", "school-plan", "publisher-catalog", "canonical-design"]},
        "url": {"type": "string", "format": "uri"},
        "locator": {"type": "string", "minLength": 1},
        "verifiedAt": {"type": "string", "format": "date"},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "notes": {"type": "string"}
  }
}
