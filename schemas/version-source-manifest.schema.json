{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alien0077/tw-junior-cap-learning/schemas/version-source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["updatedAt", "cacheRoot", "policy", "sources"],
  "properties": {
    "updatedAt": {"type":"string","format":"date"},
    "cacheRoot": {"type":"string","minLength":1},
    "policy": {"type":"string","minLength":20},
    "sources": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["subject","publisher","sourceType","url","localFile","locator"],"properties":{"subject":{"enum":["chinese","english","math","science","social"]},"publisher":{"type":"string","minLength":2},"sourceType":{"enum":["local-download","public-web","licensed-file","public-domain"]},"url":{"type":"string","format":"uri"},"localFile":{"type":"string","minLength":1},"locator":{"type":"string","minLength":5}}}}
  }
}
