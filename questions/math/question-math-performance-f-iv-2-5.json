  "subject": "math",
  "type": "single-choice",
  "prompt": "將 y＝x² 的圖形向右平移 1 單位，再向上平移 2 單位，所得函數為何？",
  "options": [
    {
      "id": "A",
      "text": "y＝(x－1)²－2"
    },
    {
      "id": "B",
      "text": "y＝(x＋1)²－2"
    },
    {
      "id": "C",
      "text": "y＝(x－1)²＋2"
    },
    {
      "id": "D",
      "text": "y＝(x＋1)²＋2"
    }
  ],
  "knowledgeIds": [
    "kg-math-performance-f-iv-2"
  ],
  "difficulty": "medium",
  "answer": {
    "value": "C",
    "explanation": "向右 1 單位把 x 改為 x－1，向上 2 單位在外面加 2，因此為 y＝(x－1)²＋2。"
  },
