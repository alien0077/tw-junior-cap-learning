  "prompt":"【112 年國中教育會考數學科第 5 題】坐標平面上，一次函數 y=-2x-6 的圖形通過下列哪一個點？",
  "options":[{"id":"A","text":"(-4,1)"},{"id":"B","text":"(-4,2)"},{"id":"C","text":"(-4,-1)"},{"id":"D","text":"(-4,-2)"}],
